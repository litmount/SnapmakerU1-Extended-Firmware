#!/bin/sh

GO2RTC_DAEMON="/usr/local/sbin/go2rtc"
GO2RTC_PIDFILE="/var/run/go2rtc.pid"
GO2RTC_CONFIG_DIR="/home/lava/printer_data/go2rtc"
GO2RTC_CONFIG="$GO2RTC_CONFIG_DIR/go2rtc.yaml"
GO2RTC_CONFIG_DEFAULT="/usr/local/share/go2rtc/go2rtc.yaml"

# Load config from user
EXTENDED_CFG="/home/lava/printer_data/config/extended/extended2.cfg"
IPCAM=$(/usr/local/bin/extended-config.py get "$EXTENDED_CFG" camera ipcam none)

start() {
    if [ "$IPCAM" != "go2rtc" ]; then
        echo "IP camera (go2rtc) is not enabled in extended2.cfg, not starting."
        exit 0
    fi

    if [ -f "$GO2RTC_PIDFILE" ] && kill -0 "$(cat "$GO2RTC_PIDFILE")" 2>/dev/null; then
        echo "go2rtc already running"
        return 0
    fi

    if [ ! -x "$GO2RTC_DAEMON" ]; then
        echo "go2rtc binary not found. Run 'go2rtc-pkg download' first."
        exit 1
    fi

    mkdir -p "$GO2RTC_CONFIG_DIR"
    chown lava:lava "$GO2RTC_CONFIG_DIR"

    if [ ! -f "$GO2RTC_CONFIG" ]; then
        echo "Installing default go2rtc config to $GO2RTC_CONFIG"
        cp "$GO2RTC_CONFIG_DEFAULT" "$GO2RTC_CONFIG"
        chown lava:lava "$GO2RTC_CONFIG"
    fi

    printf "Starting go2rtc: "
    start-stop-daemon -S -b -m -c lava \
        -p "$GO2RTC_PIDFILE" \
        -x "$GO2RTC_DAEMON" -- \
        -config "$GO2RTC_CONFIG"
    echo "OK"
}

stop() {
    printf "Stopping go2rtc: "
    if [ -f "$GO2RTC_PIDFILE" ]; then
        start-stop-daemon -K -p "$GO2RTC_PIDFILE" -s TERM
        rm -f "$GO2RTC_PIDFILE"
        echo "OK"
    else
        echo "not running"
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        sleep 1
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
